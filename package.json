{
	"name": "personal-rag",
	"version": "0.2.0",
	"description": "Private local RAG over WordPress posts and pages using Ollama and WordPress Playground.",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "wp-scripts build src/admin/index.js --output-path=build",
		"i18n": "wp i18n make-pot . languages/personal-rag.pot --domain=personal-rag --exclude=node_modules,vendor,tests,playwright-report,test-results,build",
		"lint:js": "node --check src/admin/index.js && node --check tests/e2e/personal-rag.spec.js && node --check tests/e2e/support/playground.js",
		"lint:php": "find . -path './vendor' -prune -o -path './node_modules' -prune -o -path './.tmp' -prune -o -path './build' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
		"lint:phpcs": "vendor/bin/phpcs",
		"test": "npm run build && npm run lint:js && npm run lint:php && npm run lint:phpcs && npm run test:phpunit && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:phpunit": "npx @wp-playground/cli run-blueprint --port=9401 --mount=.:/wordpress/wp-content/plugins/personal-rag --php=8.3 --wp=latest --blueprint=tests/blueprints/phpunit.json"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"@wordpress/api-fetch": "^7.46.0",
		"@wordpress/components": "^33.1.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^6.19.0",
		"@wordpress/icons": "^13.1.0",
		"@wordpress/scripts": "^30.17.0",
		"@wp-playground/cli": "^2.0.19"
	}
}
